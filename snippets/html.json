  "Aging Health - Printable 7-Day Log": {
    "prefix": "ah-log",
    "body": [
      "<!-- Printable 7-Day Tracker -->",
      "<style>",
      "  @media print {",
      "    body * { visibility: hidden !important; }",
      "    #ah-printable-log, #ah-printable-log * { visibility: visible !important; }",
      "    #ah-printable-log {",
      "      position: absolute !important;",
      "      left: 0 !important;",
      "      top: 0 !important;",
      "      width: 100% !important;",
      "      margin: 0 !important;",
      "      padding: 12px !important;",
      "      border: 1px solid #0f172a !important;",
      "      background-color: #ffffff !important;",
      "      color: #000000 !important;",
      "      box-shadow: none !important;",
      "    }",
      "    #ah-print-log-btn { display: none !important; }",
      "  }",
      "</style>",
      "<div id=\"ah-printable-log\" style=\"background-color: #ffffff; border: 2px solid #0284c7; border-radius: 8px; color: #1f2937; margin: 28px 0px; padding: 20px 22px;\">",
      "  <div style=\"display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px;\">",
      "    <h3 style=\"color: #0f172a; font-size: 21px; margin: 0px;\">Printable 7-Day ${1:Symptom & Activity} Log</h3>",
      "    <button id=\"ah-print-log-btn\" type=\"button\" onclick=\"window.print()\" style=\"background-color: #014a69; border: none; border-radius: 6px; color: #ffffff; cursor: pointer; font-size: 15px; font-weight: 600; padding: 8px 14px;\">Print This 7-Day Log</button>",
      "  </div>",
      "  <p style=\"color: #334155; font-size: 16px; margin: 0px 0px 14px 0px;\">${2:Fill in one row each day for a week and bring this sheet to your doctor visit.}</p>",
      "  <div style=\"display: flex; flex-wrap: wrap; gap: 16px; font-size: 15px; margin-bottom: 14px; color: #0f172a;\">",
      "    <span><strong>Name:</strong> ___________________________</span>",
      "    <span><strong>Week Starting:</strong> ______________</span>",
      "    <span><strong>${3:Notes / Medications}:</strong> _____________________</span>",
      "  </div>",
      "  <div style=\"overflow-x: auto;\">",
      "    <table style=\"border-collapse: collapse; font-size: 14px; text-align: left; width: 100%; background-color: #ffffff; color: #1f2937;\">",
      "      <thead>",
      "        <tr style=\"background-color: #014a69; color: #ffffff;\">",
      "          <th style=\"border: 1px solid #94a3b8; padding: 9px 8px; width: 10%;\">Day</th>",
      "          <th style=\"border: 1px solid #94a3b8; padding: 9px 8px; width: 22%;\">${4:Activity / Trigger}</th>",
      "          <th style=\"border: 1px solid #94a3b8; padding: 9px 8px; width: 24%;\">${5:Symptoms & Severity (1 to 10)}</th>",
      "          <th style=\"border: 1px solid #94a3b8; padding: 9px 8px; width: 22%;\">${6:What Brought Relief?}</th>",
      "          <th style=\"border: 1px solid #94a3b8; padding: 9px 8px; width: 22%;\">${7:Recovery Time / Notes}</th>",
      "        </tr>",
      "      </thead>",
      "      <tbody>",
      "        <tr style=\"background-color: #ffffff;\"><td style=\"border: 1px solid #94a3b8; padding: 10px 8px; font-weight: 700; color: #0f172a;\">Day 1</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td></tr>",
      "        <tr style=\"background-color: #f8fafc;\"><td style=\"border: 1px solid #94a3b8; padding: 10px 8px; font-weight: 700; color: #0f172a;\">Day 2</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td></tr>",
      "        <tr style=\"background-color: #ffffff;\"><td style=\"border: 1px solid #94a3b8; padding: 10px 8px; font-weight: 700; color: #0f172a;\">Day 3</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td></tr>",
      "        <tr style=\"background-color: #f8fafc;\"><td style=\"border: 1px solid #94a3b8; padding: 10px 8px; font-weight: 700; color: #0f172a;\">Day 4</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td></tr>",
      "        <tr style=\"background-color: #ffffff;\"><td style=\"border: 1px solid #94a3b8; padding: 10px 8px; font-weight: 700; color: #0f172a;\">Day 5</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td></tr>",
      "        <tr style=\"background-color: #f8fafc;\"><td style=\"border: 1px solid #94a3b8; padding: 10px 8px; font-weight: 700; color: #0f172a;\">Day 6</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td></tr>",
      "        <tr style=\"background-color: #ffffff;\"><td style=\"border: 1px solid #94a3b8; padding: 10px 8px; font-weight: 700; color: #0f172a;\">Day 7</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td><td style=\"border: 1px solid #94a3b8; padding: 10px 8px;\">&nbsp;</td></tr>",
      "      </tbody>",
      "    </table>",
      "  </div>",
      "  <p style=\"color: #475569; font-size: 13px; margin: 12px 0px 0px 0px;\"><strong>Questions to Ask at Your Visit:</strong> ${8:(1) What diagnostic tests do you recommend? (2) Which daily habits or exercises are safest for me?} &bull; <em>Educational tracking tool from AgingHealth.website</em></p>",
      "</div>$0"
    ],
    "description": "Insert a printable 7-day symptom and activity tracker for seniors to bring to doctor visits"
  }
