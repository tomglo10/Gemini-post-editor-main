{
  "Aging Health - Live Server Preview Shell": {
    "prefix": "ah-shell",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"en-US\" dir=\"ltr\">",
      "<head>",
      "  <meta charset=\"UTF-8\" />",
      "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />",
      "  <meta name=\"theme-color\" content=\"#014a69\" />",
      "  <title>${2:Post Title Preview} - Aging Health</title>",
      "",
      "  <!-- =====================================================================",
      "       MOCK BLOGGER THEME SCHEMA (<head> + Blog1 Article @id Anchors)",
      "       ===================================================================== -->",
      "  <script type=\"application/ld+json\">",
      "  {",
      "    \"@context\": \"https://schema.org\",",
      "    \"@graph\": [",
      "      {",
      "        \"@type\": \"Organization\",",
      "        \"@id\": \"https://www.aginghealth.website/#organization\",",
      "        \"name\": \"Aging Health\",",
      "        \"url\": \"https://www.aginghealth.website/\"",
      "      },",
      "      {",
      "        \"@type\": \"Person\",",
      "        \"@id\": \"https://www.aginghealth.website/#author\",",
      "        \"name\": \"Tommy T. Douglas\",",
      "        \"url\": \"https://www.aginghealth.website/\"",
      "      },",
      "      {",
      "        \"@type\": \"MedicalWebPage\",",
      "        \"@id\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html\",",
      "        \"url\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html\",",
      "        \"name\": \"${2:Post Title Preview} - Aging Health\",",
      "        \"description\": \"${3:Plain-language senior health and wellness guide from Aging Health.}\",",
      "        \"inLanguage\": \"en-US\",",
      "        \"author\": {",
      "          \"@id\": \"https://www.aginghealth.website/#author\"",
      "        },",
      "        \"publisher\": {",
      "          \"@id\": \"https://www.aginghealth.website/#organization\"",
      "        }",
      "      },",
      "      {",
      "        \"@type\": \"Article\",",
      "        \"@id\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html#article\",",
      "        \"mainEntityOfPage\": {",
      "          \"@id\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html\"",
      "        },",
      "        \"headline\": \"${2:Post Title Preview}\",",
      "        \"datePublished\": \"${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T08:00:00-06:00\",",
      "        \"dateModified\": \"${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T08:00:00-06:00\",",
      "        \"image\": {",
      "          \"@type\": \"ImageObject\",",
      "          \"url\": \"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgvY8Imc66FDeadyDRadkjNm2XtbAQt-SoAN1e0QxhHGoxrOamPe4HxpT_iosFoYdtiWjcgFcvVT2F7Og5pD2zVw_7sr1FmOOiJ1bmCvS2p2srqCaWKu6hlpTqcWJMZuOZI-k0dF2FmClZxaEbk4WmoLj0Zpu6T2eHxK6WWoXtTayMo5ioPmlxFT-vhTV7Y/s1600/og-featured.jpg\",",
      "          \"width\": 1200,",
      "          \"height\": 630",
      "        },",
      "        \"author\": {",
      "          \"@id\": \"https://www.aginghealth.website/#author\"",
      "        },",
      "        \"publisher\": {",
      "          \"@id\": \"https://www.aginghealth.website/#organization\"",
      "        }",
      "      }",
      "    ]",
      "  }",
      "  </script>",
      "",
      "  <!-- =====================================================================",
      "       BLOGGER THEME HELPER: Dynamic ScholarlyArticle Schema Injector",
      "       ===================================================================== -->",
      "  <script type=\"text/javascript\">",
      "  function createScholarlyArticleSchema(input) {",
      "    const entries = Array.isArray(input) ? input : [input];",
      "    const scriptId = 'ah-scholarly-citations';",
      "    let scriptEl = document.getElementById(scriptId);",
      "    let graphData = {",
      "      \"@context\": \"https://schema.org\",",
      "      \"@graph\": []",
      "    };",
      "",
      "    if (scriptEl && scriptEl.textContent) {",
      "      try {",
      "        const parsed = JSON.parse(scriptEl.textContent);",
      "        if (Array.isArray(parsed[\"@graph\"])) {",
      "          graphData = parsed;",
      "        }",
      "      } catch (e) {}",
      "    } else {",
      "      scriptEl = document.createElement('script');",
      "      scriptEl.type = 'application/ld+json';",
      "      scriptEl.id = scriptId;",
      "      document.head.appendChild(scriptEl);",
      "    }",
      "",
      "    const createdSchemas = entries.map(function (entry) {",
      "      const title = entry.title;",
      "      const authors = Array.isArray(entry.authors) ? entry.authors : [];",
      "      const year = entry.year;",
      "      const journal = entry.journal;",
      "      const pmid = entry.pmid;",
      "      const pmcid = entry.pmcid;",
      "      const doi = entry.doi;",
      "",
      "      const formattedPmcid = pmcid",
      "        ? (String(pmcid).toUpperCase().startsWith('PMC') ? String(pmcid).toUpperCase() : 'PMC' + String(pmcid).trim())",
      "        : null;",
      "      const cleanPmid = pmid ? String(pmid).replace(/\\D/g, '') : null;",
      "      const cleanDoi = doi ? String(doi).replace(/^https?:\\/\\/(dx\\.)?doi\\.org\\//i, '').trim() : null;",
      "",
      "      const sameAsUrls = [];",
      "      if (formattedPmcid) sameAsUrls.push('https://www.ncbi.nlm.nih.gov/pmc/articles/' + formattedPmcid + '/');",
      "      if (cleanPmid) sameAsUrls.push('https://pubmed.ncbi.nlm.nih.gov/' + cleanPmid + '/');",
      "      if (cleanDoi) sameAsUrls.push('https://doi.org/' + cleanDoi);",
      "",
      "      const schema = {",
      "        \"@type\": \"ScholarlyArticle\",",
      "        \"name\": title",
      "      };",
      "",
      "      if (sameAsUrls.length > 0) {",
      "        schema.url = sameAsUrls[0];",
      "        schema.sameAs = sameAsUrls;",
      "      }",
      "      if (authors.length > 0) {",
      "        schema.author = authors.map(function (name) { return { \"@type\": \"Person\", \"name\": name }; });",
      "      }",
      "      if (year) {",
      "        schema.datePublished = String(year);",
      "      }",
      "      if (journal) {",
      "        schema.isPartOf = {",
      "          \"@type\": \"PublicationIssue\",",
      "          \"isPartOf\": {",
      "            \"@type\": \"Periodical\",",
      "            \"name\": journal",
      "          }",
      "        };",
      "      }",
      "",
      "      const alreadyAdded = graphData[\"@graph\"].some(function (item) {",
      "        return item.name === schema.name || (schema.url && item.url === schema.url);",
      "      });",
      "      if (!alreadyAdded) {",
      "        graphData[\"@graph\"].push(schema);",
      "      }",
      "",
      "      return Object.assign({ \"@context\": \"https://schema.org\" }, schema);",
      "    });",
      "",
      "    scriptEl.textContent = JSON.stringify(graphData);",
      "    return Array.isArray(input) ? createdSchemas : createdSchemas[0];",
      "  }",
      "  </script>",
      "",
      "  <!-- =====================================================================",
      "       LOCAL PREVIEW STYLES (Excluded automatically by build-blogger-post.ps1)",
      "       ===================================================================== -->",
      "  <style>",
      "    :root {",
      "      --ah-primary: #014a69;",
      "      --ah-primary-light: #e8f3f8;",
      "      --ah-text: #1e293b;",
      "      --ah-muted: #475569;",
      "      --ah-border: #cbd5e1;",
      "      --ah-bg: #ffffff;",
      "    }",
      "    * { box-sizing: border-box; }",
      "    body {",
      "      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;",
      "      font-size: 18px;",
      "      line-height: 1.7;",
      "      color: var(--ah-text);",
      "      background: var(--ah-bg);",
      "      max-width: 780px;",
      "      margin: 0 auto;",
      "      padding: 0 20px 64px;",
      "    }",
      "    h2 {",
      "      color: var(--ah-primary);",
      "      font-size: 1.55rem;",
      "      margin-top: 2rem;",
      "      border-bottom: 2px solid var(--ah-primary-light);",
      "      padding-bottom: 0.35rem;",
      "    }",
      "    h3 {",
      "      color: #0f172a;",
      "      font-size: 1.25rem;",
      "      margin-top: 1.5rem;",
      "    }",
      "    a { color: var(--ah-primary); text-decoration-thickness: 1.5px; }",
      "    img { max-width: 100%; height: auto; border-radius: 8px; }",
      "    table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }",
      "    th, td { border: 1px solid var(--ah-border); padding: 10px 12px; text-align: left; }",
      "    th { background: var(--ah-primary-light); color: var(--ah-primary); }",
      "    .ah-faq-section details,",
      "    .ah-article-glossary details {",
      "      border: 1px solid var(--ah-border);",
      "      border-radius: 8px;",
      "      padding: 12px 16px;",
      "      margin-bottom: 12px;",
      "      background: #f8fafc;",
      "    }",
      "    .ah-faq-section summary,",
      "    .ah-article-glossary summary {",
      "      font-weight: 600;",
      "      cursor: pointer;",
      "      color: var(--ah-primary);",
      "    }",
      "    .ah-article-glossary dt { font-weight: 700; color: var(--ah-primary); margin-top: 10px; }",
      "    .ah-article-glossary dd { margin: 4px 0 12px 0; }",
      "    #ah-preview-bar {",
      "      position: sticky;",
      "      top: 0;",
      "      z-index: 999;",
      "      background: #0f172a;",
      "      color: #f8fafc;",
      "      padding: 10px 14px;",
      "      margin: 0 -20px 24px;",
      "      border-bottom: 3px solid var(--ah-primary);",
      "      font-size: 14px;",
      "      display: flex;",
      "      flex-wrap: wrap;",
      "      align-items: center;",
      "      justify-content: space-between;",
      "      gap: 10px;",
      "    }",
      "    #ah-preview-bar button {",
      "      background: var(--ah-primary);",
      "      color: #fff;",
      "      border: 1px solid #38bdf8;",
      "      border-radius: 5px;",
      "      padding: 6px 12px;",
      "      font-size: 13px;",
      "      font-weight: 600;",
      "      cursor: pointer;",
      "    }",
      "    #ah-preview-bar button:hover { background: #02638c; }",
      "    #ah-schema-drawer {",
      "      display: none;",
      "      background: #0f172a;",
      "      color: #e2e8f0;",
      "      padding: 16px;",
      "      margin: -16px -20px 24px;",
      "      border-radius: 0 0 8px 8px;",
      "      font-size: 13px;",
      "    }",
      "    #ah-schema-drawer pre {",
      "      background: #1e293b;",
      "      padding: 12px;",
      "      border-radius: 6px;",
      "      overflow-x: auto;",
      "      max-height: 420px;",
      "      line-height: 1.45;",
      "    }",
      "    .ah-preview-title-block {",
      "      border-bottom: 1px solid var(--ah-border);",
      "      margin-bottom: 24px;",
      "      padding-bottom: 12px;",
      "    }",
      "    .ah-preview-title-block h1 {",
      "      font-size: 2rem;",
      "      line-height: 1.25;",
      "      color: #0f172a;",
      "      margin: 0 0 8px;",
      "    }",
      "    .ah-preview-byline { font-size: 15px; color: var(--ah-muted); }",
      "  </style>",
      "</head>",
      "<body>",
      "",
      "<!-- PREVIEW-UI-START -->",
      "<div id=\"ah-preview-bar\">",
      "  <div>",
      "    <strong>Aging Health Local Preview</strong> &bull;",
      "    <span id=\"ah-schema-badge\">Scanning JSON-LD...</span>",
      "  </div>",
      "  <div>",
      "    <button type=\"button\" id=\"ah-toggle-schema\">Inspect JSON-LD Graph</button>",
      "    <button type=\"button\" id=\"ah-copy-schema\">Copy All JSON-LD</button>",
      "  </div>",
      "</div>",
      "",
      "<div id=\"ah-schema-drawer\">",
      "  <div id=\"ah-graph-audit\" style=\"margin-bottom: 10px; font-weight: 600;\"></div>",
      "  <pre id=\"ah-schema-output\"></pre>",
      "</div>",
      "",
      "<header class=\"ah-preview-title-block\">",
      "  <h1>${2:Post Title Preview}</h1>",
      "  <div class=\"ah-preview-byline\">By <strong>Tommy T. Douglas</strong> &bull; Aging Health</div>",
      "</header>",
      "<!-- PREVIEW-UI-END -->",
      "",
      "<!-- =======================================================================",
      "     POST BODY CONTENT START (Everything below is compiled for Blogger)",
      "     ======================================================================= -->",
      "",
      "<p>$0</p>",
      "",
      "<!-- =======================================================================",
      "     POST BODY CONTENT END",
      "     ======================================================================= -->",
      "",
      "<!-- PREVIEW-UI-START -->",
      "<script>",
      "(function () {",
      "  function refreshSchemaInspector() {",
      "    const scripts = Array.from(document.querySelectorAll('script[type=\"application/ld+json\"]'));",
      "    const badge = document.getElementById('ah-schema-badge');",
      "    const auditEl = document.getElementById('ah-graph-audit');",
      "    const outputEl = document.getElementById('ah-schema-output');",
      "",
      "    const parsedBlocks = [];",
      "    const definedIds = new Set();",
      "    const referencedIds = new Set();",
      "    const typesFound = [];",
      "    let parseErrors = 0;",
      "",
      "    function walkNode(node, isRef) {",
      "      if (!node || typeof node !== 'object') return;",
      "      if (Array.isArray(node)) {",
      "        node.forEach(function (item) { walkNode(item, isRef); });",
      "        return;",
      "      }",
      "      const keys = Object.keys(node);",
      "      if (node['@type']) {",
      "        typesFound.push(Array.isArray(node['@type']) ? node['@type'].join('+') : node['@type']);",
      "      }",
      "      if (node['@id']) {",
      "        if (keys.length === 1) {",
      "          referencedIds.add(node['@id']);",
      "        } else {",
      "          definedIds.add(node['@id']);",
      "        }",
      "      }",
      "      keys.forEach(function (k) {",
      "        if (k !== '@id' && typeof node[k] === 'object') {",
      "          walkNode(node[k], true);",
      "        }",
      "      });",
      "    }",
      "",
      "    scripts.forEach(function (s, idx) {",
      "      try {",
      "        const obj = JSON.parse(s.textContent);",
      "        parsedBlocks.push(obj);",
      "        walkNode(obj, false);",
      "      } catch (err) {",
      "        parseErrors++;",
      "        parsedBlocks.push({ _error: 'Block #' + (idx + 1) + ' invalid JSON: ' + err.message });",
      "      }",
      "    });",
      "",
      "    const unresolved = Array.from(referencedIds).filter(function (id) { return !definedIds.has(id); });",
      "    badge.textContent = scripts.length + ' JSON-LD block(s) | Types: ' + (typesFound.join(', ') || 'None');",
      "",
      "    if (parseErrors > 0) {",
      "      auditEl.style.color = '#f87171';",
      "      auditEl.textContent = 'JSON Syntax Errors: ' + parseErrors;",
      "    } else if (unresolved.length > 0) {",
      "      auditEl.style.color = '#fbbf24';",
      "      auditEl.textContent = 'Unresolved @id references (check slug match): ' + unresolved.join(', ');",
      "    } else {",
      "      auditEl.style.color = '#4ade80';",
      "      auditEl.textContent = 'All ' + referencedIds.size + ' @id graph link(s) resolved cleanly.';",
      "    }",
      "",
      "    outputEl.textContent = JSON.stringify(parsedBlocks, null, 2);",
      "  }",
      "",
      "  window.addEventListener('DOMContentLoaded', function () {",
      "    refreshSchemaInspector();",
      "",
      "    const drawer = document.getElementById('ah-schema-drawer');",
      "    document.getElementById('ah-toggle-schema').addEventListener('click', function () {",
      "      refreshSchemaInspector();",
      "      drawer.style.display = drawer.style.display === 'block' ? 'none' : 'block';",
      "    });",
      "",
      "    document.getElementById('ah-copy-schema').addEventListener('click', async function (e) {",
      "      refreshSchemaInspector();",
      "      const text = document.getElementById('ah-schema-output').textContent;",
      "      await navigator.clipboard.writeText(text);",
      "      const btn = e.target;",
      "      btn.textContent = 'Copied!';",
      "      setTimeout(function () { btn.textContent = 'Copy All JSON-LD'; }, 1500);",
      "    });",
      "  });",
      "})();",
      "</script>",
      "<!-- PREVIEW-UI-END -->",
      "",
      "</body>",
      "</html>"
    ],
    "description": "Insert Aging Health Live Server preview wrapper with filename-synced MedicalWebPage/Article @id graph and schema inspector"
  },
