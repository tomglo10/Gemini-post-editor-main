      "  </details>",
      "  <details>",
      "    <summary>${3:Second question?}</summary>",
      "    <p>${4:Clear, plain-language answer.}</p>",
      "  </details>",
      "</section>",
      "$0"
    ],
    "description": "Insert visible .ah-faq-section HTML that build-blogger-post.ps1 compiles into FAQPage JSON-LD"
  },
