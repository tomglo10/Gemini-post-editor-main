  "Aging Health - DefinedTermSet Glossary JSON-LD (Graph-Linked)": {
    "prefix": "ah-glossary",
    "body": [
      "<!-- DefinedTermSet Glossary Structured Data -->",
      "<script type=\"application/ld+json\">",
      "{",
      "  \"@context\": \"https://schema.org\",",
      "  \"@type\": \"DefinedTermSet\",",
      "  \"@id\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html#glossary\",",
      "  \"url\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html#glossary\",",
      "  \"name\": \"${2:Topic Name} Medical Glossary\",",
      "  \"description\": \"Plain-language definitions of key medical and clinical terms referenced in ${2:Topic Name}.\",",
      "  \"inLanguage\": \"en-US\",",
      "  \"mainEntityOfPage\": {",
      "    \"@id\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html\"",
      "  },",
      "  \"subjectOf\": {",
      "    \"@id\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html#article\"",
      "  },",
      "  \"isPartOf\": {",
      "    \"@type\": \"DefinedTermSet\",",
      "    \"@id\": \"https://www.aginghealth.website/p/glossary.html#glossary-hub\",",
      "    \"name\": \"Aging Health Medical & Senior Wellness Glossary\",",
      "    \"url\": \"https://www.aginghealth.website/p/glossary.html\"",
      "  },",
      "  \"hasDefinedTerm\": [",
      "    {",
      "      \"@type\": \"DefinedTerm\",",
      "      \"@id\": \"https://www.aginghealth.website/${1:${TM_FILENAME_BASE}}.html#term-${3:term-slug}\",",
      "      \"name\": \"${4:Medical Term}\",",
