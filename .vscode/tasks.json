{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Blogger Post",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build-blogger-post.ps1",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Suggest Internal Links for Current Draft",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/suggest-internal-links.ps1",
        "-DraftPath",
        "${input:draftPicker}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Audit & Sync Sitemap",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/audit-sitemap.ps1",
        "-PingBing"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Refresh Local Keyword Map",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/generate-keyword-map.ps1"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "draftPicker",
      "type": "pickString",
      "description": "Choose which HTML draft in posts/ to scan for internal links",
      "options": [
        {
          "label": "Newest Draft in posts/ (Auto-Detect)",
          "value": ""
        },
        {
          "label": "Browse All HTML Files in posts/ (Live Window)",
          "value": "__PICK__"
        },
        {
          "label": "wisdom-aging-brain-cognitive-shifts.html",
          "value": "posts/wisdom-aging-brain-cognitive-shifts.html"
        }
      ],
      "default": ""
    }
  ]
}