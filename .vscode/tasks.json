{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aging Health: Build & Audit Blogger Post",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build-blogger-post.ps1",
        "-HtmlFilePath",
        "${file}",
        "-PostSlug",
        "${input:postSlug}",
        "-TopicName",
        "${input:topicName}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "postSlug",
      "type": "promptString",
      "description": "Blogger Post Slug (press Enter to use current filename):",
      "default": "${fileBasenameNoExtension}"
    },
    {
      "id": "topicName",
      "type": "promptString",
      "description": "Topic Name for DefinedTermSet schema (optional — press Enter to auto-generate from slug):",
      "default": ""
    }
  ]
}